# Client vars (Vite) — exposed in the browser bundle. Prefix: VITE_
# Copy this file to `.env` and fill in.

# Backend base URL (Express API). In production point this at your deployed backend.
VITE_API_BASE_URL=http://localhost:5000/api

# Shared api key sent as x-api-key (must equal backend API_KEY).
VITE_API_KEY=replace-with-backend-api-key

# NOTE: admin auth + the GitHub token now live in the BACKEND (.env there).
# No admin or GitHub secrets belong in the frontend anymore.
