# ─────────────────────────────────────────────────────────────────────────────
# CLIENT vars (Vite) — exposed in the browser bundle. Prefix: VITE_
# Copy this file to `.env` and fill in.
# ─────────────────────────────────────────────────────────────────────────────

# Chat backend (Express) base URL + shared api key (must equal backend API_KEY)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_API_KEY=replace-with-backend-api-key


# ─────────────────────────────────────────────────────────────────────────────
# SERVER vars — used ONLY by the Vercel serverless functions in /api.
# These are NOT prefixed with VITE_ so they never reach the browser.
# Set them in: Vercel → Project → Settings → Environment Variables.
# (Do NOT put real secrets in this committed file — values here are placeholders.)
# ─────────────────────────────────────────────────────────────────────────────

# Password that unlocks the /admin dashboard.
ADMIN_PASSWORD=choose-a-strong-password

# GitHub PAT with Contents read/write on the frontend repo.
# Fine-grained token recommended: Repository access = this repo,
# Permissions → Contents = Read and write.
GITHUB_TOKEN=github_pat_xxx

# "owner/repo" of the repository Vercel deploys this frontend from.
GITHUB_REPO=your-username/your-frontend-repo

# Branch Vercel builds production from (usually main).
GITHUB_BRANCH=main

# Path to the data file INSIDE the repo. If Vercel's project root is this
# `frontend/` folder, the repo path is just src/data/selectedWork.json.
# If the repo root is the parent `my-portfolio/`, use frontend/src/data/selectedWork.json
GITHUB_FILE_PATH=src/data/selectedWork.json
